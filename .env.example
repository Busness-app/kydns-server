# Copy to .env and edit. docker compose reads it automatically.
#
# KyDNS joins a LAN-attached Docker network your host already owns, so the
# container gets its own address on your LAN and binds port 53 there without
# fighting systemd-resolved or dnsmasq on the host.

# The existing network to join. unRAID calls it br0, which is the default. If
# AdGuard Home or Pi-hole already has a LAN address, this is the network it is
# on — `docker network ls` will show it.
#
# Compose creates this network if it is missing, and adopts it if you already
# have one. `make setup` fills in the interface, subnet and gateway it needs.
KYDNS_NETWORK=br0

# The address KyDNS will answer on. Two requirements:
#   - inside the network's subnet, which `docker network inspect $KYDNS_NETWORK`
#     reports
#   - OUTSIDE your router's DHCP pool, or the router will lease it to something
#     else and you get an intermittent address conflict
#
# Running beside an existing AdGuard Home or Pi-hole? Pick a different address
# from theirs and both work at once, which is how you cut over one client at a
# time instead of the whole house.
KYDNS_IP=192.168.1.53

# Where the config file lives on the host. Copied from kydns.example.yaml.
KYDNS_CONFIG=./kydns.yaml

# Backups. Optional. The schedule default; the admin UI setting wins once set.
# KYDNS_BACKUP_DEPOSIT_INTERVAL=24h
# Local sealed copies: absolute path inside the container, mounted as a volume.
# KYDNS_BACKUP_DIR=/var/backups/kydns
# KYDNS_BACKUP_KEEP=7
# KyRecovery on your own LAN behind a TLS proxy. HTTPS is still required.
# KYDNS_BACKUP_ALLOW_PRIVATE_RECOVERY=false
# LAN resolver for the container, used only with docker-compose.lan-dns.yml on
# the command line. A value here alone does nothing.
# KYDNS_DNS=192.168.1.1
