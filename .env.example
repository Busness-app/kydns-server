# Copy to .env and edit. docker compose reads it automatically.
#
# These give the KyDNS container its own IP address on your LAN, so it binds
# port 53 on that address and never fights systemd-resolved or dnsmasq on the
# host.

# ---------------------------------------------------------------------------
# Driver: ipvlan or macvlan
#
#   macvlan  gives the container its own MAC address. Use it on wired
#            ethernet. It does NOT work over WiFi: access points reject a
#            station sending multiple MAC addresses, so traffic silently
#            disappears.
#
#   ipvlan   shares the host's MAC and only adds an IP. This is what works
#            over WiFi, and it is fine on ethernet too. Docker defaults it to
#            L2 mode, which is what you want here.
#
# If unsure, ipvlan is the safer default.
KYDNS_NET_DRIVER=ipvlan

# The host interface carrying your LAN. `ip -o -4 route show default` names it.
KYDNS_PARENT_IF=eth0

# Your LAN subnet and router, in CIDR form.
#   ip -o -4 addr show dev $KYDNS_PARENT_IF
#   ip -o -4 route show default
KYDNS_SUBNET=192.168.1.0/24
KYDNS_GATEWAY=192.168.1.1

# The address KyDNS will answer on. Two requirements:
#   - inside KYDNS_SUBNET
#   - OUTSIDE your router's DHCP pool, or the router will hand it to something
#     else and you get an address conflict
KYDNS_IP=192.168.1.53

# Where the config file lives on the host. Copied from kydns.example.yaml.
KYDNS_CONFIG=./kydns.yaml
